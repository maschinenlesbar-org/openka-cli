  ],
  "bundleDependencies": [
    "@maschinenlesbar.org/openka-cli-ka",
    "@maschinenlesbar.org/openka-cli-ka-factory",
    "@maschinenlesbar.org/openka-connector-baden-wuerttemberg",
    "@maschinenlesbar.org/openka-connector-bayern",
    "@maschinenlesbar.org/openka-connector-berlin",
    "@maschinenlesbar.org/openka-connector-brandenburg",
    "@maschinenlesbar.org/openka-connector-bremen",
    "@maschinenlesbar.org/openka-connector-bund",
    "@maschinenlesbar.org/openka-connector-hamburg",
    "@maschinenlesbar.org/openka-connector-hessen",
    "@maschinenlesbar.org/openka-connector-mecklenburg-vorpommern",
    "@maschinenlesbar.org/openka-connector-niedersachsen",
    "@maschinenlesbar.org/openka-connector-nordrhein-westfalen",
