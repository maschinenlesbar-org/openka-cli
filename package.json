{
  "name": "@maschinenlesbar.org/openka-cli",
  "version": "0.0.1",
  "description": "OpenKA \u2014 German parliamentary Kleine Anfragen from 17 incompatible systems in one reproducible, machine-readable schema. Deterministic runtime: no generative model on the line.",
  "type": "module",
  "bin": {
    "ka": "dist/src/bin/ka.js",
    "ka-factory": "dist/src/bin/ka-factory.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "LICENSING.md",
    "CONTRIBUTING.md",
    "DATA_LICENSE.md",
    "CONCEPT.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"const {rmSync,readdirSync}=require('fs');rmSync('dist',{recursive:true,force:true});for(const p of readdirSync('packages'))rmSync('packages/'+p+'/dist',{recursive:true,force:true})\"",
    "build": "tsc -b tsconfig.json tsconfig.test.json",
    "stamp": "npm run build && node tools/stamp.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "pretest": "npm run build",
    "test": "npm test --workspaces --if-present && node --test dist/test/*.test.js",
    "lint:line": "node packages/cli-ka-factory/dist/src/cli/index.js lint",
    "docs": "node tools/docs/node_modules/typedoc/bin/typedoc src/index.ts --out out",
    "start": "node packages/cli-ka/dist/src/index.js"
  },
  "keywords": [
    "kleine-anfrage",
    "parlament",
    "bundestag",
    "landtag",
    "open-data",
    "reproducible",
    "cli"
  ],
  "author": "Sebastian Sch\u00fcrmann <sebs@2xs.org>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maschinenlesbar-org/openka-cli.git"
  },
  "bugs": {
    "url": "https://github.com/maschinenlesbar-org/openka-cli/issues"
  },
  "homepage": "https://maschinenlesbar-org.github.io/openka-cli/",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/sebs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@maschinenlesbar.org/openka-cli-ka": "0.0.1",
    "@maschinenlesbar.org/openka-cli-ka-factory": "0.0.1",
    "@maschinenlesbar.org/openka-connector-baden-wuerttemberg": "0.0.1",
    "@maschinenlesbar.org/openka-connector-bayern": "0.0.1",
    "@maschinenlesbar.org/openka-connector-berlin": "0.0.1",
    "@maschinenlesbar.org/openka-connector-brandenburg": "0.0.1",
    "@maschinenlesbar.org/openka-connector-bremen": "0.0.1",
    "@maschinenlesbar.org/openka-connector-bund": "0.0.1",
    "@maschinenlesbar.org/openka-connector-hamburg": "0.0.1",
    "@maschinenlesbar.org/openka-connector-hessen": "0.0.1",
