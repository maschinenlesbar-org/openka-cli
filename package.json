    "@maschinenlesbar.org/openka-connector-schleswig-holstein": "0.0.1",
    "@maschinenlesbar.org/openka-connector-thueringen": "0.0.1",
    "@maschinenlesbar.org/openka-lib-errors": "0.0.1",
    "@maschinenlesbar.org/openka-lib-extract": "0.0.1",
