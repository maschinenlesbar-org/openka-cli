    "@maschinenlesbar.org/openka-connector-niedersachsen": "0.0.1",
    "@maschinenlesbar.org/openka-connector-nordrhein-westfalen": "0.0.1",
    "@maschinenlesbar.org/openka-connector-rheinland-pfalz": "0.0.1",
