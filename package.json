    "@maschinenlesbar.org/openka-lib-pardok",
    "@maschinenlesbar.org/openka-lib-parlamentsspiegel",
    "@maschinenlesbar.org/openka-lib-pdf",
    "@maschinenlesbar.org/openka-lib-perceive",
    "@maschinenlesbar.org/openka-lib-pipeline",
    "@maschinenlesbar.org/openka-lib-registry",
    "@maschinenlesbar.org/openka-lib-render",
    "@maschinenlesbar.org/openka-lib-repro",
