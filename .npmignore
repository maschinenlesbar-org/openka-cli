# The published package ships only the compiled library (dist/src), declared via
# the "files" allowlist in package.json. This .npmignore is a second line of
# defence so source, tests, CI and tooling never end up in the tarball even if
# the allowlist is loosened.

# Sources & tests
src/
test/
dist/test/

# Tooling & config
tsconfig.json
.github/
.gitignore
.npmignore

# Skills & Claude Code plugin packaging (not part of the npm package)
skills/
.claude-plugin/
SKILLS.md

# Build/scratch artifacts
out/
dist-artifacts/
*.log
.DS_Store

# Golden fixtures: real parliamentary PDFs plus their frozen records. They are the
# regression suite, not part of the library, and they are a third of a megabyte.
fixtures/

# Website (Jekyll source) — not built in this repo yet.
site/
