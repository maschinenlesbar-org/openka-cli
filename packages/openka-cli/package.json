    "@maschinenlesbar.org/openka-lib-extract": "0.0.1",
    "@maschinenlesbar.org/openka-lib-http": "0.0.1",
    "@maschinenlesbar.org/openka-lib-models": "0.0.1",
    "@maschinenlesbar.org/openka-lib-pardok": "0.0.1",
    "@maschinenlesbar.org/openka-lib-parlamentsspiegel": "0.0.1",
