{
  "name": "@maschinenlesbar.org/openka-cli",
  "version": "0.0.1",
  "description": "OpenKA \u2014 German parliamentary Kleine Anfragen from 17 incompatible systems in one reproducible, machine-readable schema. Deterministic runtime: no generative model on the line.",
  "type": "module",
  "bin": {
    "ka": "dist/src/bin/ka.js",
    "ka-factory": "dist/src/bin/ka-factory.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "LICENSING.md",
    "CONTRIBUTING.md",
    "DATA_LICENSE.md",
    "CONCEPT.md"
  ],
  "scripts": {
    "prepack": "tsc -b ../../tsconfig.json && node ../../tools/prepack.mjs",
    "test": "node --test dist/test/*.test.js",
    "postpack": "node ../../tools/postpack.mjs"
  },
  "dependencies": {
    "@maschinenlesbar.org/openka-cli-ka": "0.0.1",
    "@maschinenlesbar.org/openka-cli-ka-factory": "0.0.1",
