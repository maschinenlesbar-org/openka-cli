# Local working plan (not part of the published project)
plan.md

# The drift baseline is a measurement of one machine's corpus, not a fixture.
# `ka-factory health --save-baseline` now writes it into the corpus; the old
# default path stays ignored so a baseline left over from before is not committed.
fixtures/health-baseline.json

# Copied into an app by tools/pack/prepack.mjs for the length of a pack, and removed again
# by tools/pack/postpack.mjs (the bundled packages land in the app's node_modules/).
apps/*/.prepack-generated.json
apps/*/package-readme.parked.md
apps/*/README.md
apps/*/LICENSE
apps/*/LICENSING.md
apps/*/CONTRIBUTING.md
apps/*/DATA_LICENSE.md
apps/*/CONCEPT.md
