{
  "name": "@maschinenlesbar.org/openka-cli",
  "version": "0.12.0",
  "description": "OpenKA — German parliamentary Kleine Anfragen from 17 incompatible systems in one reproducible, machine-readable schema. Deterministic runtime: no generative model on the line.",
  "type": "module",
  "bin": {
    "ka": "dist/src/bin/ka.js",
    "ka-factory": "dist/src/bin/ka-factory.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "dist/node_modules",
    "!dist/src/**/*.map",
    "LICENSING.md",
    "CONTRIBUTING.md",
    "DATA_LICENSE.md",
    "CONCEPT.md"
  ],
  "scripts": {
    "prepack": "tsc -b ../../tsconfig.json && node ../../tools/pack/prepack.mjs",
    "version": "node ../../tools/version.mjs",
    "test": "node --test $(node -p \"+process.versions.node.split('.')[0] >= 24 ? '--test-timeout=5000' : ''\") dist/test/*.test.js",
    "postpack": "node ../../tools/pack/postpack.mjs"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "bundleDependencies": [
    "commander"
  ],
  "keywords": [
    "kleine-anfrage",
    "parlament",
    "bundestag",
    "landtag",
    "open-data",
    "reproducible",
    "cli"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Sebastian Schürmann <sebs@2xs.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maschinenlesbar-org/openka-cli.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/maschinenlesbar-org/openka-cli/issues"
  },
  "homepage": "https://maschinenlesbar.org/openka-cli/",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/sebs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@maschinenlesbar.org/openka-lib-testing": "0.0.1"
  },
  "peerDependencies": {
    "tesseract.js": ">=5"
  },
  "peerDependenciesMeta": {
    "tesseract.js": {
      "optional": true
    }
  }
}
